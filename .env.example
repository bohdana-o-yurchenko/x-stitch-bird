# Local development settings. Copy this file to `.env.local` (git ignores it) and fill it in with the values of the
# Neon **dev** branch — never production. Production values live only in Vercel (Project → Settings → Environment
# Variables). Scripts that change the database refuse to run unless told the target (see scripts/db/migrate.mjs).
#
# Neon console → project → Branches → `dev` (create it from `production` once, without an expiry date). Then, with
# the `dev` branch selected:

# Connect → Connection string, "Pooled connection" on
DATABASE_URL=
# Connect → Connection string, "Pooled connection" off (migrations use it)
DATABASE_URL_UNPOOLED=

# Auth → Configuration: "Auth URL" and "JWKS URL" (each branch has its own users and sign-in settings)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Any long random text, not the production one: `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# Storage → the `assets` bucket → Credentials: a credential for this branch, and the branch's S3 endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1

# The branch's name, for your own reference (shown by the scripts)
NEON_BRANCH=dev
